  "modules": [
    {
      "id": "MOD-100",
      "name": "Data Pipeline - Rutas y Geometrías",
      "priority": "critical",
      "status": "not_started",
      "estimated_hours": 2.0,
      "depends_on": [],
      "context": {
        "problem": "Datos de rutas están en CSV sin geometría de línea, solo puntos de destino",
        "impact": "Sin GeoJSON de rutas, no se puede visualizar la red logística en el mapa",
        "root_cause": "Rutas calculadas con Sakbe API devuelven solo distancias, no trazados"
      },
      "tasks": [
        {
          "id": "MOD-100-T01",
          "title": "Generar GeoJSON de rutas logísticas con geometrías reales (Sakbe API)",
          "type": "data_loader",
          "description": "Usar geointelligence.apis.inegi.sakbe_routing para obtener geometrías de rutas REALES de carreteras mexicanas. Crear archivo GeoJSON con LineStrings que siguen la Red Nacional de Caminos.",
          "status": "pending",
          "hours": {"estimated": 1.5, "actual": 0},
          "technical_meta": {
            "loader_name": "rutas_logisticas.json",
            "language": "python",
            "output_format": "geojson",
            "files_affected": ["src/data/rutas_logisticas.json"],
            "source_files": ["src/data/rutas_sakbe_nuevas.csv"],
            "geointelligence_module": "geointelligence.apis.inegi.sakbe_routing.INEGISakbeRoutingClient",
            "method": "calculate_route_by_coordinates()",
            "origin_point": {
              "name": "Planta FCarnes Monterrey",
              "lat": 25.6866,
              "lon": -100.3161
            },
            "geometry_strategy": "real_roads_from_sakbe_api",
            "note": "La API de Sakbe devuelve geometrías LineString que siguen carreteras reales. RouteResult.geometry contiene el trazado.",
            "fallback": "Si Sakbe falla para alguna ruta, usar línea recta con advertencia",
            "python_script_example": "notebooks/fcarnes/scripts/generate_routes_geojson.py",
            "properties_per_route": [
              "destino", "distancia_km", "costo_total", "costo_casetas", 
              "costo_combustible", "zona_logistica", "tiempo_horas", "source"
            ]
          },
          "acceptance_criteria": [
            "GeoJSON válido con 17 features tipo LineString",
            "Geometrías siguen carreteras reales (no líneas rectas)",
            "Propiedades incluyen costos y zona logística",
            "Campo 'source' indica si es 'sakbe' o 'estimation'",
            "Archivo < 500KB (geometrías reales son más grandes)"
          ]
        },
        {
          "id": "MOD-100-T02",
          "title": "Crear GeoJSON de nodos logísticos",
          "type": "data_loader",
          "description": "Crear archivo GeoJSON con puntos de Planta, posibles CEDIS y nodos de distribución",
          "status": "pending",
          "hours": {"estimated": 0.5, "actual": 0},
          "technical_meta": {
            "loader_name": "nodos_logisticos.json",
            "language": "static",
            "output_format": "geojson",
            "files_affected": ["src/data/nodos_logisticos.json"],
            "nodes": [
              {
                "name": "Planta FCarnes Monterrey",
                "type": "planta_principal",
                "lat": 25.68,
                "lon": -100.31,
                "icon": "factory"
              },
              {
                "name": "Destino Tijuana",
                "type": "destino_lejano",
                "lat": 32.5149,
                "lon": -117.0382
              }
            ],
            "note": "Incluir todos los destinos de rutas como nodos"
          },
          "acceptance_criteria": [
            "GeoJSON válido con puntos",
            "Planta principal marcada como origen",
            "Destinos incluidos con tipo (LOCAL, FORANEA, LEJANA)"
          ]
        },
        {
          "id": "MOD-100-T03",
          "title": "Enriquecer prospectos con distancia a ruta más cercana (Python/Shapely)",
          "type": "data_loader",
          "description": "Pre-calcular distancia de cada prospecto al corredor logístico más cercano usando Shapely. Esto es más eficiente que calcular en el navegador.",
          "status": "pending",
          "hours": {"estimated": 0.75, "actual": 0},
          "technical_meta": {
            "language": "python",
            "calculation": "shapely.distance() point to LineString",
            "algorithm": "Project point to line, calculate geodesic distance",
            "files_affected": ["src/data/prospectos_sample.json"],
            "new_fields": {
              "distancia_ruta_km": "Distancia en km al corredor más cercano",
              "ruta_cercana": "Nombre del destino de la ruta más cercana",
              "en_corredor": "Boolean: True si distancia < 25km"
            },
            "python_implementation": {
              "library": "shapely",
              "method": "LineString.distance(Point) en CRS proyectado (EPSG:6372)",
              "crs_note": "Calcular distancias en metros con CRS proyectado, luego convertir a km"
            },
            "output": "Actualizar prospectos_sample.json con campos adicionales"
          },
          "acceptance_criteria": [
            "Cada prospecto tiene campo distancia_ruta_km",
            "Campo ruta_cercana indica qué ruta está más cerca",
            "Campo en_corredor facilita filtrado rápido",
            "Distancias calculadas correctamente (verificar con casos conocidos)"
          ]
        }
      ],
      "testing": {
        "data_validation_tests": [
          {"id": "DV-100-01", "description": "Todas las rutas tienen geometría válida"},
          {"id": "DV-100-02", "description": "Distancias calculadas son consistentes con distancia_planta_km existente"}
        ]
      }
